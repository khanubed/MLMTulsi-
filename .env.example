# ==========================================
# Tulsi Swaraj - Environment Variables Example
# ==========================================

# Environment & Server
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tulsi_swaraj

# Authentication
SESSION_SECRET=replace-with-long-random-secret
ADMIN_BOOTSTRAP_EMAIL=admin@tulsiswaraj.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-secure-password

# PhonePe Payment Gateway (Official API configuration)
PHONEPE_ENV=sandbox
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_MERCHANT_ID=
PHONEPE_CALLBACK_URL=http://localhost:4000/api/v1/payments/phonepe/callback
PHONEPE_REDIRECT_URL=http://localhost:3000/checkout/payment-status

# Provider Selection & Testing Flags (mock in development)
OTP_PROVIDER=mock
PAYMENT_PROVIDER=mock
MOCK_OTP_EXPOSE_CODE=true
MOCK_PAYMENT_ALLOW_SUCCESS=true

# Observability
LOG_LEVEL=info
