# ==============================================================================
# Tulsi Swaraj - Web Application Environment Configuration Template
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Application Public Origin
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL Database Connection URL (Prisma)
# Direct connection for migrations / Session pooler:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tulsimlm?schema=public
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/tulsimlm?schema=public

# Session Authentication & Cookie Signing Secret (minimum 32 random characters)
SESSION_SECRET=tulsi_swaraj_dev_session_secret_replace_in_production_min_32_chars

# ------------------------------------------------------------------------------
# PROVIDER SELECTION (Provider Independence Architecture)
# ------------------------------------------------------------------------------
# In Development: Use 'mock' to run entirely offline without third-party credentials.
# In Production: Must be a verified real provider (e.g., 'phonepe_sms', 'phonepe').
OTP_PROVIDER=mock
PAYMENT_PROVIDER=mock

# ------------------------------------------------------------------------------
# DEVELOPER TESTING FLAGS (FORBIDDEN IN PRODUCTION - Will abort startup if enabled)
# ------------------------------------------------------------------------------
# When true in dev/test, responses include 'developmentOtp' for instant browser testing.
MOCK_OTP_EXPOSE_CODE=true
# When true in dev/test, simulator routes allow immediate simulated success.
MOCK_PAYMENT_ALLOW_SUCCESS=true

# ------------------------------------------------------------------------------
# FUTURE PHONEPE GATEWAY CONFIGURATION (Live / Sandbox)
# ------------------------------------------------------------------------------
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox
PHONEPE_MERCHANT_ID=PGTESTPAYUAT86
PHONEPE_SALT_KEY=96434309-7796-489d-8924-ab56988a6076
PHONEPE_SALT_INDEX=1
PHONEPE_CALLBACK_URL=http://localhost:3000/api/v1/webhooks/phonepe

# ------------------------------------------------------------------------------
# FUTURE SMS GATEWAY CONFIGURATION (Live)
# ------------------------------------------------------------------------------
SMS_PROVIDER_API_KEY=sample_sms_provider_api_key_placeholder
SMS_SENDER_ID=TULSIS

# ------------------------------------------------------------------------------
# INITIAL ADMINISTRATOR CREDENTIALS (Bootstrap)
# ------------------------------------------------------------------------------
ADMIN_BOOTSTRAP_EMAIL=admin@tulsiswaraj.com
ADMIN_BOOTSTRAP_PASSWORD=AdminSecurePassword@2026
